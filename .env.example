# ==============================================================================
# ⚡ Loadly — Environment Configuration
# ==============================================================================

# Server Port (default: 8000)
PORT=8000

# Allowed CORS Origins (comma-separated list)
# Used for cross-origin requests when the frontend is served on a different origin/domain.
# Leave as localhost for local development, or set your production frontend domain.
# Example: ALLOWED_ORIGINS=https://loadly.example.com,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8000

# OpenRouter API Key (Optional)
# Required only for conversational LLM responses in the AI Energy Assistant.
# If omitted, local Sentence-Transformers embeddings (all-MiniLM-L6-v2) and FAISS
# handle grounded knowledge retrieval without calling external LLMs.
# Obtain a key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Frontend API Base URL (Optional)
# Only needed when deploying the React frontend separately (e.g., on Vercel/Netlify).
# When running unified under FastAPI (Docker or python server.py), leave this blank.
# Example: VITE_API_URL=https://loadly-api.onrender.com
VITE_API_URL=

# Operator Admin Key (Required to use admin endpoints)
# Guards the state-changing endpoints: POST /api/ledger/actuals, /api/ingestion/run,
# /api/mlops/retrain and /api/mlops/rollback. Clients send it in the X-Admin-Key header.
# If unset, empty, or shorter than 24 characters, those endpoints are disabled (HTTP 503).
# Never expose it through a VITE_ variable — the web UI asks the operator for it at runtime.
# Generate one with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
LOADLY_ADMIN_KEY=

# Development auto-reload for `python server.py` (set to 1 to enable; leave unset in production)
LOADLY_DEV=
